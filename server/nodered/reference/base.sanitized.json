  {
    "id": "5a0582668ed9c9ae",
    "type": "function",
    "z": "6a09c3f845bb0be5",
    "g": "4b2ac603bb7bd26b",
    "name": "CHECK: Alarma Térmica",
    "func": "// Validamos que el payload sea un objeto JSON parseado\nif (typeof msg.payload !== \"object\") return null;\n\nlet mosto = msg.payload.mosto;\nlet setpoint = msg.payload.setpoint;\n\n// Si falta data, abortamos\nif (mosto === undefined || setpoint === undefined) return null;\n\n// Calculamos el diferencial\nlet delta = Math.abs(mosto - setpoint);\n\n// UMBRAL CRÍTICO: Si el mosto se desvía 2°C o más del objetivo\nif (delta >= 20.0) {\n    let alerta = `🚨 ALERTA CRÍTICA: Desvío térmico.\\n\\n`;\n    alerta += `🌡 Mosto: ${mosto}°C\\n`;\n    alerta += `🎯 Setpoint: ${setpoint}°C\\n`;\n    alerta += `📈 Delta T: ${delta.toFixed(2)}°C\\n\\n`;\n    alerta += `Revisar compresor o estado del relé en el nodo Edge.`;\n\n    return { payload: alerta };\n}\n\n// Si la temperatura es normal, el flujo muere acá\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
