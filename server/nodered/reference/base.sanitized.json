    "type": "function",
    "z": "6a09c3f845bb0be5",
    "g": "93751e838cbcf62b",
    "name": "CONF: Receta Ale",
    "func": "// ==========================================\n// CONFIGURACIÓN DE LA RECETA ACTUAL\n// ==========================================\n// Podés duplicar este nodo para diferentes cervezas\n// y conectar el que quieras usar al botón de \"Iniciar\".\n\nconst recetaActual = {\n    nombre: \"Ale Americana (US-05)\",\n    perfil: [\n        { dia: 0, temp: 3.0 },  // Inoculación\n        { dia: 1, temp: 3.0 },  // Fin Fase Log\n        { dia: 2, temp: 3.0 },  // Pico Diacetilo\n        { dia: 6, temp: 3.0 },  // Fin Diacetilo\n        { dia: 7, temp: 3.0 },   // Cold Crash\n        { dia: 10, temp: 3.0 }   // Fin Acondicionamiento\n    ]\n};\n\n// Guardamos la receta en el disco del contenedor (\"file\")\nflow.set(\"receta_activa\", recetaActual.perfil, \"file\");\nflow.set(\"nombre_receta\", recetaActual.nombre, \"file\");\n\n// Pasamos el mensaje al siguiente nodo (Setear Fecha Cero)\nmsg.payload = \"Cargando receta: \" + recetaActual.nombre;\nreturn msg;",
