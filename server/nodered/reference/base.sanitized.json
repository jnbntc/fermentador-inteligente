    "name": "PARSE: JSON Telemetría",
    "func": "// Si no es un objeto JSON válido, abortamos\nif (typeof msg.payload !== \"object\") return msg;\n\n// Levantamos las variables de tiempo de la RAM de Node-RED\nlet dTrans = flow.get(\"dias_transcurridos\") || 0;\nlet dRest = flow.get(\"dias_restantes\") || 0;\n\n// Inyectamos la data al payload que va a InfluxDB\nmsg.payload.dias_trans = dTrans;\nmsg.payload.dias_rest = dRest;\n\nreturn msg;",
