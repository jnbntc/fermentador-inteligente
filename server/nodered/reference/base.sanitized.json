    "name": "function 1",
    "func": "// Extraemos los valores parseados y los casteamos a Float\nlet temp = parseFloat(msg.payload.temperatura_c);\nlet hum = parseFloat(msg.payload.humedad_relativa);\nlet qnh = parseFloat(msg.payload.presion_qnh_hpa);\nlet rssi = parseInt(msg.payload.rssi_wifi);\n\n// Formato InfluxDB v2: msg.payload = [ {fields}, {tags} ]\nmsg.payload = [\n    {\n        temperatura: temp,\n        humedad: hum,\n        presion: qnh,\n        rssi: rssi\n    },\n    {\n        sensor: \"bmp280_am2301\",\n        ubicacion: \"exterior_techo\"\n    }\n];\n\n// El measurement (la \"tabla\" de Influx)\nmsg.measurement = \"clima\";\n\nreturn msg;",
