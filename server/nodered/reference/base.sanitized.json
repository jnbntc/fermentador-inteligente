  {
    "id": "45246b272efb8409",
    "type": "function",
    "z": "6a09c3f845bb0be5",
    "g": "4b2ac603bb7bd26b",
    "name": "FORMAT: Mensaje Alerta",
    "func": "// Capturamos el texto crudo que viene del nodo anterior\nlet mensajeCrudo = msg.payload;\n\nmsg.payload = {\n    chatId: env.get(\"TELEGRAM_CHAT_ID\"), // <--- REEMPLAZÁ ESTO POR TU CHAT ID EXACTO\n    type: \"message\",\n    content: mensajeCrudo\n};\n\nreturn msg;",
