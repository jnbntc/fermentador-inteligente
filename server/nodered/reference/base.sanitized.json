  {
    "id": "48dcb958f555ae77",
    "type": "function",
    "z": "6a09c3f845bb0be5",
    "g": "93751e838cbcf62b",
    "name": "CORE: Orquestador PID",
    "func": "// ==========================================\n// 1. RECUPERACIÓN DE DATOS Y ESTADO\n// ==========================================\n// Volvemos a exigir lectura desde disco físico (\"file\")\nconst receta = flow.get(\"receta_activa\", \"file\");\nconst fechaInicio = flow.get(\"inicio_fermentacion\", \"file\");\n\n// Si no hay receta cargada o no hay fecha de inicio, estamos en Standby\nif (!receta || !fechaInicio) {\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"Standby\" });\n    return null;\n}\n\n// Cálculo de tiempo (SIN Time Warp)\nconst msTranscurridos = Date.now() - fechaInicio;\nconst diasTranscurridos = msTranscurridos / (1000 * 60 * 60 * 24);\n\nlet setpointCalculado = receta[0].temp;\n\n// ==========================================\n// 3. MOTOR DE INTERPOLACIÓN TÉRMICA\n// ==========================================\nfor (let i = 0; i < receta.length - 1; i++) {\n    let p1 = receta[i];\n    let p2 = receta[i + 1];\n\n    if (diasTranscurridos >= p1.dia && diasTranscurridos <= p2.dia) {\n        // Cálculo de la pendiente (y = mx + b)\n        let deltaTemp = p2.temp - p1.temp;\n        let deltaDias = p2.dia - p1.dia;\n        let fraccionDeRampa = (diasTranscurridos - p1.dia) / deltaDias;\n\n        setpointCalculado = p1.temp + (deltaTemp * fraccionDeRampa);\n        break;\n    } else if (diasTranscurridos > receta[receta.length - 1].dia) {\n        // Si superamos el día final, mantenemos el frío indefinidamente\n        setpointCalculado = receta[receta.length - 1].temp;\n    }\n}\n\n// ==========================================\n// 4. CÁLCULO DE TIEMPOS Y TELEMETRÍA UI\n// ==========================================\nlet diasTotales = receta[receta.length - 1].dia;\nlet diasRestantes = Math.max(0, diasTotales - diasTranscurridos);\n\n// Recuperación persistente del último estado enviado\nlet ultimoSetpoint = flow.get(\"ultimo_setpoint\", \"file\");\nsetpointCalculado = Math.round(setpointCalculado * 100) / 100;\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `Día ${(diasTranscurridos).toFixed(2)} | SP: ${setpointCalculado}°C`\n});\n\nlet msgUI = {\n    payload: {\n        setpoint: parseFloat(setpointCalculado),\n        transcurridos: parseFloat(diasTranscurridos.toFixed(2)),\n        restantes: parseFloat(diasRestantes.toFixed(2)),\n        total: parseFloat(diasTotales)\n    }\n};\n\n// Escritura persistente condicionada para no fundir el SSD con I/O inútil\nif (ultimoSetpoint === undefined || Math.abs(setpointCalculado - ultimoSetpoint) >= 0.05) {\n    flow.set(\"ultimo_setpoint\", setpointCalculado, \"file\");\n    return [{ payload: setpointCalculado.toString() }, msgUI];\n}\n\n// Persistencia de la telemetría UI\nflow.set(\"dias_transcurridos\", parseFloat(diasTranscurridos.toFixed(2)), \"file\");\nflow.set(\"dias_restantes\", parseFloat(diasRestantes.toFixed(2)), \"file\");\n\nreturn [null, msgUI];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 890,
    "y": 580,
    "wires": [
